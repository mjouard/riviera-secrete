# Copy to .env.local and fill in values
# For local dev: point to your local API (dotnet run in backend/)
# For production: use the Railway API URL
NEXT_PUBLIC_API_URL=https://api-production-19623.up.railway.app

# Public URL of this frontend deployment — used to build absolute URLs (OG tags,
# JSON-LD, sitemap.xml, the PDF export header). Falls back to the current Vercel
# prod URL in code if unset, but set it explicitly once a custom domain exists.
NEXT_PUBLIC_SITE_URL=https://frontend-two-plum-92.vercel.app

# NextAuth — https://next-auth.js.org/configuration/options
# NEXTAUTH_SECRET: random string used to sign/encrypt the session JWT (generate with
# `openssl rand -base64 32`). NEXTAUTH_URL: this deployment's own URL (NextAuth uses
# it to build OAuth callback URLs) — required in production, optional in local dev.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI must be <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Invalidation du cache ISR après une modification de contenu en base.
# Sans ce secret, l'endpoint /api/revalidate refuse tout appel (503) et le contenu se
# rafraîchit seulement au bout d'une heure — c'est ce qui a laissé une page /en proposer
# un château fermé depuis 2015. Générer avec `openssl rand -hex 32`, poser la MÊME valeur
# ici (et sur Vercel) et dans l'environnement où tourne RivieraSecrete.Tools, qui l'envoie
# en en-tête `x-revalidate-secret` avec FRONTEND_URL.
REVALIDATE_SECRET=
